flush ruleset

table inet filter {
    # -------------------------------------------------------------
    # Address sets for access control and policy routing
    # -------------------------------------------------------------
    set wg_trusted_clients {
        type ipv4_addr
        flags interval
        elements = { <SPOKE1_TUNNEL_IP>, <SPOKE2_TUNNEL_IP>, <CLIENT1_DIRECT_IP>, <CLIENT2_DIRECT_IP> }
    }

    set wg_rerouted_clients {
        type ipv4_addr
        flags interval
        elements = { <CLIENT1_REROUTE_IP>, <CLIENT2_REROUTE_IP> }
    }

    # Internal subnets excluded from public WAN masquerading
    set private_networks {
        type ipv4_addr
        flags interval
        elements = { <WG_SUBNET>, <SPOKE1_SITE_SUBNET>, <SPOKE2_SITE_SUBNET> }
    }

    # -------------------------------------------------------------
    # INPUT CHAIN: Traffic directed to the HUB host itself
    # -------------------------------------------------------------
    chain input {
        type filter hook input priority filter; policy drop;

        # Local loopback
        iif "lo" accept

        # Connection tracking: accept established/related, drop invalid
        ct state invalid drop
        ct state established,related accept

        # ICMP rate limiting
        ip protocol icmp icmp type { destination-unreachable, time-exceeded } accept
        ip protocol icmp icmp type echo-request limit rate 5/second burst 5 packets accept
        ip6 nexthdr ipv6-icmp icmpv6 type {
            destination-unreachable, packet-too-big, time-exceeded,
            parameter-problem, echo-request, nd-router-advert,
            nd-neighbor-solicit, nd-neighbor-advert
        } accept

        # External SSH management with brute-force rate limit
        iif "<WAN_IFACE>" tcp dport <SSH_PORT> ct state new meter ssh-meter size 65535 { ip saddr limit rate over 10/minute burst 5 packets } drop
        iif "<WAN_IFACE>" tcp dport <SSH_PORT> ct state new accept

        # WireGuard inbound UDP port
        iif "<WAN_IFACE>" udp dport <WG_LISTEN_PORT> accept

        # Access to local HUB services (monitoring, internal SSH) from authorized WG peers
        iifname "<WG_IFACE>" ip saddr @wg_trusted_clients accept
    }

    # -------------------------------------------------------------
    # FORWARD CHAIN: Transit traffic between interfaces
    # -------------------------------------------------------------
    chain forward {
        type filter hook forward priority filter; policy drop;

        ct state established,related accept
        ct state invalid drop

        # 1. Inter-spoke / site-to-site transit (clients to remote spoke site subnets)
        iifname "<WG_IFACE>" oifname "<WG_IFACE>" ip saddr @wg_trusted_clients ip daddr { <SPOKE1_SITE_SUBNET>, <SPOKE2_SITE_SUBNET> } accept

        # 2. PBR transit: Route specific clients through Spoke 1 for secondary exit
        iifname "<WG_IFACE>" oifname "<WG_IFACE>" ip saddr @wg_rerouted_clients ip daddr != <WG_SUBNET> accept

        # 3. Direct Internet transit via HUB WAN for standard clients
        iifname "<WG_IFACE>" oif "<WAN_IFACE>" ip saddr @wg_trusted_clients ct state new accept
    }

    # -------------------------------------------------------------
    # OUTPUT CHAIN: Outbound traffic originating from the HUB
    # -------------------------------------------------------------
    chain output {
        type filter hook output priority filter; policy accept;
    }
}

table ip nat {
    chain postrouting {
        type filter hook postrouting priority srcnat; policy accept;

        # Masquerade traffic exiting HUB WAN, excluding internal private networks
        oif "<WAN_IFACE>" ip saddr <WG_SUBNET> ip daddr != @private_networks masquerade
    }
}